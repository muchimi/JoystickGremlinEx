    "version": "0.2.0",
    "configurations": [

        {
            "variablePresentation": {"all": "hide"},
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gremlinEx.py",
            "console": "integratedTerminal",
            "args": ["/no-mousehook"],
            "env": {
                "PYTHONPATH": "${workspaceFolder};${env:PYTHONPATH}",
                "GEX_DIAGNOSTIC_MODE": "1",
                "GEX_MAESTRO_ENABLED": "1",
                "GEX_OSC_ENABLED": "1",
                "GEX_MIDI_ENABLED": "0",
                "GEX_OVERLAY_ENABLED": "0",
                "GEX_AFCS_ENABLED": "0",
                "GEX_STREAMDECK_ENABLED": "0",
                "GEX_OCTAVI_ENABLED": "0",
                

            },
            //"justMyCode": false,
            "justMyCode": true,
            // "rules": [
            //     {
            //         "path": "${workspaceFolder}/gremlin/sound.py",
            //         "include": false
            //     }
            // ],
            "subProcess": false,
            //"args": ["/r"],
            //"args": ["--np"],
            //"args": ["--h"],
            //"args" : ["--p","sc ex.xml","--r"]

        }
    ]
}
